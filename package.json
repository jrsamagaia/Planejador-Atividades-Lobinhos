{
  "name": "planejador-alcateia",
  "version": "2.0.0",
  "private": true,
  "description": "Planejador de Atividades do Ramo Lobinho — Cloudflare Workers + D1 + R2 + Gemini.",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "dev:ui": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
    "db:migrate:local": "wrangler d1 migrations apply planejador-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply planejador-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "hono": "^4.9.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "wrangler": "^4.149.0"
  }
}
