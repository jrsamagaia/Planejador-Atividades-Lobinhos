{
  "entities": {
    "UserConfig": {
      "title": "User Configuration",
      "description": "User specific settings and library data",
      "type": "object",
      "properties": {
        "velhosLobos": {
          "type": "array",
          "description": "List of responsible leaders",
          "items": { "type": "string" }
        },
        "adjustmentTerms": {
          "type": "array",
          "description": "Mapping for term replacements",
          "items": {
            "type": "object",
            "properties": {
              "original": { "type": "string" },
              "replaced": { "type": "string" }
            },
            "required": ["original", "replaced"]
          }
        },
        "libraryData": {
          "type": "array",
          "description": "Categorized library items",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "url": { "type": "string" }
                  },
                  "required": ["name"]
                }
              },
              "hidden": { "type": "boolean" }
            },
            "required": ["category", "items"]
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["velhosLobos", "adjustmentTerms", "libraryData", "updatedAt"]
    },
    "GrupoEscoteiro": {
      "title": "Grupo Escoteiro",
      "description": "Informações do Grupo Escoteiro",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "cnpj": { "type": "string" },
        "endereco": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "logoUrl": { "type": "string" },
        "observacoes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome"]
    },
    "Secao": {
      "title": "Seção do Grupo Escoteiro",
      "description": "Seções (ex: Ramo Lobinho, Alcateia) pertencentes a um Grupo",
      "type": "object",
      "properties": {
        "grupoId": { "type": "string" },
        "nome": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["grupoId", "nome"]
    },
    "Perfil": {
      "title": "Perfil do Usuário",
      "description": "Tipos de perfil do sistema, ex: Administrador, Chefe de Seção",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "ativo"]
    },
    "UsuarioDoc": {
      "title": "Cadastro de Usuário",
      "description": "Perfil e status de autorização do usuário",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "nome": { "type": "string" },
        "perfilId": { "type": "string" },
        "perfilNome": { "type": "string" },
        "grupoId": { "type": "string" },
        "secaoId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "nome", "perfilId", "grupoId", "secaoId", "status"]
    },
    "ActivityHistoryItem": {
      "title": "Item do Histórico de Atividades",
      "description": "Atividade planejada e gravada no histórico do usuário ou global",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "responsavel": { "type": "string" },
        "dataAplicacao": { "type": "string" },
        "date": { "type": "string" },
        "plan": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "grupoId": { "type": "string" },
        "secaoId": { "type": "string" }
      },
      "required": ["theme", "responsavel", "dataAplicacao", "date", "plan", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/config/main": {
      "schema": "UserConfig",
      "description": "Main configuration document for a specific user"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "ActivityHistoryItem",
      "description": "Legacy per-user private activity history items"
    },
    "/activities/{activityId}": {
      "schema": "ActivityHistoryItem",
      "description": "Global activity history items tied to group and section"
    },
    "/grupos/{grupoId}": {
      "schema": "GrupoEscoteiro",
      "description": "Registered Scout Groups"
    },
    "/secoes/{secaoId}": {
      "schema": "Secao",
      "description": "Registered Scout Group units/sections"
    },
    "/perfis/{perfilId}": {
      "schema": "Perfil",
      "description": "System access roles"
    },
    "/usuarios/{userId}": {
      "schema": "UsuarioDoc",
      "description": "Extended user profile and registration status"
    }
  }
}
